sequenceDiagram
    autonumber
    actor User as [Actor] Partner / Admin / Customer
    participant ListPage as [Pres] VoucherListPage
    participant Api as [Pres] getVouchersByPartnerApi
    participant Ctrl as [Pres] VoucherController
    participant Service as [Bus] VoucherService
    participant Repo as [Data] VoucherRepository
    participant PartnerRepo as [Data] PartnerRepository
    participant DB as [Data] Supabase DB

    User->>ListPage: openPage(partnerId, query)
    ListPage->>Api: getVouchersByPartnerApi(partnerId, query)
    Api->>Ctrl: GET /api/vouchers/partner/:partnerId
    Ctrl->>Service: getVouchersByPartner(partnerId, query)
    Service->>Repo: findByPartnerId(partnerId, query)

    Repo->>PartnerRepo: findById(partnerId)
    Note over Repo, PartnerRepo: Lấy thông tin ma_hs và ten_dn của đối tác

    Repo->>DB: SELECT * FROM chinhanh WHERE ma_hs = targetMaHs
    Repo->>DB: SELECT * FROM voucher_cn WHERE ma_chi_nhanh IN (...)
    Repo->>DB: SELECT *, danh_muc(ten_danh_muc) FROM voucher WHERE ma_voucher IN (...)
    DB-->>Repo: return voucherRows

    loop for each voucher item
        Note over Repo: Tính gia_ban = gia_goc - gia_tri_giam<br/>Tạo new VoucherModel(...) gán ten_dn, ten_danh_muc
    end

    Repo-->>Service: return VoucherModel[]
    Service-->>Ctrl: return vouchers
    Ctrl-->>ListPage: res.json({ success: true, data: vouchers })

sequenceDiagram
    autonumber
    actor User as [Actor] Partner / Admin / Customer
    participant DetailPage as [Pres] VoucherDetailPage
    participant Api as [Pres] getVoucherByIdApi
    participant Ctrl as [Pres] VoucherController
    participant Service as [Bus] VoucherService
    participant Repo as [Data] VoucherRepository
    participant AuditRepo as [Data] AuditLogRepository
    participant DB as [Data] Supabase DB

    User->>DetailPage: selectVoucher(voucherId)
    DetailPage->>Api: getVoucherByIdApi(voucherId)
    Api->>Ctrl: GET /api/vouchers/:id
    Ctrl->>Service: getVoucherById(id)
    Service->>Repo: findById(id)

    Repo->>DB: SELECT *, danh_muc(ten_danh_muc) FROM voucher WHERE ma_voucher = id
    DB-->>Repo: return voucherData

    Repo->>DB: SELECT ma_chi_nhanh FROM voucher_cn WHERE ma_voucher = id

    opt if voucher status is "Tu choi" and ly_do_tu_choi is empty
        Repo->>AuditRepo: getLatestRejectionReason("VOUCHER", id)
        AuditRepo->>DB: SELECT ly_do_thuc_hien, du_lieu_sau FROM log_ht WHERE doi_tuong = 'VOUCHER' AND hanh_dong ILIKE '%REJECT%'
        DB-->>AuditRepo: return rejectionReasonText
        AuditRepo-->>Repo: return lyDoTuChoi
    end

    Repo-->>Service: return VoucherModel
    Service-->>Ctrl: return voucher
    Ctrl-->>DetailPage: res.json({ success: true, data: voucher })